{
  "name": "pickmamind-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:prod": "pnpm run build && cross-env NODE_ENV=production node dist/main",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check:staged": "biome check --staged --write --no-errors-on-unmatched",
    "check:ci": "biome ci .",
    "analyze": "knip",
    "gen:module": "nest generate module",
    "gen:controller": "nest generate controller",
    "gen:service": "nest generate service",
    "gen:resource": "nest generate resource",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.10.7",
    "cross-env": "^10.1.0",
    "knip": "^5.86.0",
    "lefthook": "^2.1.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "yarn": "please-use-pnpm"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
